# Python
__pycache__/
*.pyc
*.pyo

# Virtualenv
venv/
.venv/

# App runtime / data (root only — app/registry/data/ is versioned spec data)
/data/
instance/
*.sqlite
*.sqlite3

# Secrets & local backups (kept on the host, not in git)
.env
# Generated first-admin password (0600, written by the seed / installer)
/initial-admin-password
/initial-admin-password.*.tmp
*.bak
*.bak-*

# Host-only snapshots (may contain .env secrets) — never commit.
# Anchored: unanchored, this also shadowed the tracked templates under
# app/templates/backups/, which keep working only until someone deletes
# and re-adds them. data/backups (the device vault) stays covered by /data/.
/backups/

# Phase 9 system backup bundles (binary, large)
data/system_backups/

# editor/session backup snapshots (never commit/ship)
*.pre-*
.cache/

# empty legacy artifact — runtime DB is PostgreSQL
fortinet.db

# node-local PKI — internal CA key + node/service certs, NEVER commit
pki/

# node-local SSH for the HA datasync — on the standby it holds the PRIVATE key
# (id_ha_rsync) and on the primary the peer's authorized_keys. NEVER commit.
/.ssh/
dist/
.gitconfig

# node-local renewal journal (per-node truth; NEVER replicated)
/state/

# Names of THIS deployment for the documentation redactor. Untracked on
# purpose: a rule table that names the estate it protects is itself the
# disclosure it exists to prevent. See docs/safeguards.md 7e.
publication-rules.local.json

# Retired git SoT (2026-08-05): the live tree moved to data/reports; the
# old repo-root path survives only as an untracked compat symlink.
/reports
/reports/

# Root-level hidden scratch: .patch_a.py, .smoke1.py, .runsuite.sh, .suite.log...
# A module name cannot start with a dot, so a dot-prefixed file at the repo root
# is never importable code -- it is always a throwaway. Ignored for two reasons:
# an unrelated `git add -A` cannot sweep another session's scratch into a commit
# (it has, twice), and `git status` stays readable enough that real uncommitted
# work is visible. Scoped to the repo root and to throwaway suffixes on purpose:
# a broader rule would hide source. See docs/safeguards.md 4b and 24.
/.[!.]*.py
/.[!.]*.sh
/.[!.]*.log
/.[!.]*.rc

# Compiled catalogs: an artifact DERIVED from the .po, generated by the
# installer and by the update runner. Not versioned for two reasons: it
# carries internal identifiers that the publisher's sanitiser cannot
# rewrite without breaking the binary's offset table, and a broken binary
# gets published silently.
app/translations/*/LC_MESSAGES/*.mo
.python_history
*.mutbak
