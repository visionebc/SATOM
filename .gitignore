# Python
__pycache__/
*.pyc
*.pyo

# Virtualenv
venv/
.venv/

# App runtime / data (root only — app/registry/data/ is versioned spec data)
/data/
instance/
*.sqlite
*.sqlite3

# Secrets & local backups (kept on the host, not in git)
.env
*.bak
*.bak-*

# Host-only snapshots (may contain .env secrets) — never commit
backups/

# Phase 9 system backup bundles (binary, large)
data/system_backups/

# editor/session backup snapshots (never commit/ship)
*.pre-*
.cache/

# empty legacy artifact — runtime DB is PostgreSQL
fortinet.db

# node-local PKI — internal CA key + node/service certs, NEVER commit
pki/

# node-local SSH del datasync HA — en el standby contiene la llave PRIVADA
# (id_ha_rsync) y en el primary el authorized_keys del peer. NEVER commit.
/.ssh/
dist/
.gitconfig

# node-local renewal journal (per-node truth; NEVER replicated)
/state/

# Names of THIS deployment for the documentation redactor. Untracked on
# purpose: a rule table that names the estate it protects is itself the
# disclosure it exists to prevent. See docs/safeguards.md 7e.
publication-rules.local.json
