msgid "Every published site of this appliance with its latest grade and the result of each test, as CSV"
msgstr "Alle veröffentlichten Sites dieses Geräts mit ihrer letzten Note und dem Ergebnis jedes Tests, als CSV"

#: app/templates/observatory/index.html
msgid "Fixes applied to this site"
msgstr "Auf diese Site angewendete Korrekturen"

#: app/templates/observatory/index.html
