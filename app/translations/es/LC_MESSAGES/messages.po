msgstr "Como lo ven los usuarios"

msgid "Banner"
msgstr "Banner"

msgid "Design"
msgstr "Diseño"

msgid "Drop blocks here"
msgstr "Suelta bloques aquí"

msgid "Empty this surface: it falls back to the standard layout"
msgstr "Vaciar esta superficie: vuelve al diseño estándar"

