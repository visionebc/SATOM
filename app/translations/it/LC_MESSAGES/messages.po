msgid "Copy curl"
msgstr "Copia curl"

msgid "Download HAR"
msgstr "Scarica HAR"

msgid "View HAR"
msgstr "Visualizza HAR"

msgid "Include credential values and the response body in the HAR (audited)"
msgstr "Includi i valori delle credenziali e il corpo della risposta nell'HAR (registrato nell'audit)"

msgid "Leg B and the attack log"
msgstr "Tratta B e registro degli attacchi"

msgid "Appliance (FortiWeb)"
msgstr "Appliance (FortiWeb)"

