msgstr "Non esiste ancora nessuna versione pubblicata (Python Studio › API Catalog)."

msgid "APIs someone publishes, one entry per version: import its OpenAPI or Swagger document, or type the endpoints in. A published version never changes. Pin an HTTP connection to a version and app steps and scripts can call its endpoints by id, and only those."
msgstr "API che qualcuno pubblica, una voce per versione: importa il suo documento OpenAPI o Swagger, oppure inserisci gli endpoint. Una versione pubblicata non cambia mai. Vincola una connessione HTTP a una versione e i passi delle app e gli script potranno chiamarne gli endpoint per id, e solo quelli."

msgid "New API"
msgstr "Nuova API"

msgid "Latest published"
msgstr "Ultima pubblicata"

msgid "No APIs yet."
msgstr "Ancora nessuna API."

msgid "New trigger"
msgstr "Nuovo trigger"

msgid "Lowercase, digits, - and _. Automations and the API name it."
msgstr "Minuscole, cifre, - e _. Le automazioni e l'API lo chiamano così."

msgid "Payload fields"
msgstr "Campi del payload"

msgid "Conditions"
msgstr "Condizioni"

msgid "(all must hold; empty = any; a condition on a field the event does not carry is not met)"
msgstr "(devono valere tutte; vuoto = qualsiasi; una condizione su un campo che l'evento non contiene non è soddisfatta)"

msgid "ADOMs (product)"
msgstr "ADOM (prodotto)"

msgid "Appliance ids"
msgstr "Id delle appliance"

