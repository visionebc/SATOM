# SATOM container stack — example environment.
#
#   cp env.example .env
#   ./satom-docker.sh gen-secrets      # replaces the two CHANGE_ME_ values
#
# The entrypoint REFUSES to start while SECRET_KEY or FERNET_KEY still hold a
# placeholder. That guard is not pedantry: a published example file that
# reaches production means every session cookie is forgeable and every
# appliance password in the device vault is decryptable by anyone who has read
# this repository.

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_flask_secret

# ⚠ FERNET_KEY CANNOT BE ROTATED once appliance passwords have been encrypted
# with it. Losing or changing it does not lock you out of SATOM -- it makes
# every stored device credential permanently undecryptable. Back it up with
# the same care as the database, and NEVER copy a development value into
# production or the reverse.
FERNET_KEY=CHANGE_ME_fernet_key

# ---------------------------------------------------------------------------
# Database (the stack's own PostgreSQL container)
# ---------------------------------------------------------------------------
POSTGRES_USER=satom
POSTGRES_DB=satom
POSTGRES_PASSWORD=CHANGE_ME_postgres

# NOTE: SQLALCHEMY_DATABASE_URI is NOT set here. compose.yaml composes it from
# the three values above and overrides anything .env carries -- because .env is
# usually copied from a host node, where it points at 127.0.0.1, which inside a
# container is the container itself.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
FLASK_ENV=production
FLASK_APP=wsgi.py
TZ=Europe/Zurich

# Where the stack publishes HTTPS. The `proxy` service terminates TLS with a
# certificate the install issues for itself -- there is nothing to set up
# before the first login.
#
#   SATOM_REDIRECT_BIND is plain :80. It exists because ACME http-01 is always
#   validated over :80 even on a host that only serves TLS; everything else on
#   it is a 301 to HTTPS. Do NOT point a reverse proxy at it expecting the
#   application: it will get redirects.
SATOM_HTTPS_BIND=0.0.0.0:443
SATOM_REDIRECT_BIND=0.0.0.0:80

# Names the self-issued certificate must cover, space separated. Set this to
# the name operators actually type. A SAN that does not cover it produces a
# browser warning on a certificate the install just reported as issued, and
# the only remedy is to reissue -- so it is asked for here, up front.
# Empty falls back to the container's hostname, which is almost never right.
SATOM_SERVED_NAMES=

# SATOM_HTTP_BIND WAS the app's own published port. It is GONE: publishing
# gunicorn directly is publishing the plain-HTTP shape that made a freshly
# installed node reject every correct password. satom-docker.sh refuses to
# start if it is still set, rather than ignoring it -- an operator who thinks
# they bound to loopback and is actually on 0.0.0.0 must be told.

# Image tag. Development may use satom:local; production MUST use an immutable
# tag (compose.prod.yaml refuses :local by requiring the variable explicitly).
SATOM_IMAGE=satom:local

# The compose network, and the proxy's fixed address inside it. These three
# values are a SET: TRUSTED_PROXIES below must equal SATOM_PROXY_IP, and
# SATOM_PROXY_IP must lie inside SATOM_NETWORK_SUBNET. satom-docker.sh checks
# that before every `up`. Change them only if the default range collides with
# something on the host.
SATOM_NETWORK_SUBNET=172.28.0.0/16
SATOM_PROXY_IP=203.0.113.10

# Image tag. Development may use satom:local; production MUST use an immutable
# tag (compose.prod.yaml refuses :local by requiring the variable explicitly).
SATOM_IMAGE=satom:local

# Comma-separated hops allowed to set X-Forwarded-*. There is ALWAYS a hop:
# the container never talks to a browser directly. The hop is now the stack's
# own `proxy` service, so this is SATOM_PROXY_IP above -- not the bridge
# gateway, which is only the peer for traffic arriving through a published
# port, and not the container the app actually receives from.
#
# If you put a FURTHER proxy in front (an edge/DMZ load balancer), append its
# address: SATOM_PROXY_IP first, then the outer hop.
#
# Getting it wrong does not fail loudly. It makes every audit-log entry
# record the proxy's address as the actor's, and it collapses rate limiting
# into ONE bucket for every user -- five failed logins then lock out
# everybody. Leaving it EMPTY is not 'no proxy', it is 'trust nothing',
# which produces exactly that collapse.
TRUSTED_PROXIES=203.0.113.10

# ---------------------------------------------------------------------------
# Cluster (production only — ignored by a single-node development stack)
# ---------------------------------------------------------------------------
# primary | standby. satom-docker.sh uses this to decide whether the standby
# overlay may be applied; applying it to a primary wipes PGDATA.
SATOM_NODE_ROLE=primary

# Address:port the PRIMARY publishes PostgreSQL on, so the standby can attach.
# Always an explicit address, never 0.0.0.0.
SATOM_PG_BIND=127.0.0.1:5432

# Replication credentials. Same values on both nodes.
SATOM_REPL_USER=satom_repl
SATOM_REPL_PASSWORD=CHANGE_ME_replication

# STANDBY ONLY: where the primary lives.
SATOM_PRIMARY_HOST=
SATOM_PRIMARY_PORT=5432
