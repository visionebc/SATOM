# Fires scheduled actions. SINGLE INSTANCE across the HA pair: the guard script
# only execs the scheduler on the Postgres primary (pg_is_in_recovery = f), so
# the standby's copy idles until promoted.
[Unit]
Description=Fortinet Manager Scheduler (fires scheduled actions; primary-only)
After=network.target fortinet-manager.service postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fortinet-manager
EnvironmentFile=/opt/fortinet-manager/.env
ExecStart=/opt/fortinet-manager/deploy/scheduler_guard.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
