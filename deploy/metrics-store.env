# Identity of the metrics-store artifact. SINGLE HOME.
#
# This value is also written literally in installers/install-satom.sh and in the
# three build-offline-bundle*.sh scripts. Those four CANNOT source this file:
# the installer runs before the app tree exists, and the builders run against a
# checkout that may predate it. So they keep literals, and
# tests/test_metrics_store_install.py pins every one of them to THIS file.
#
# Why that matters: a digest that drifts between the builder and the installer
# produces a bundle the installer refuses, and that is only discovered on an
# air-gapped node — the one place with no second way to get the binary.
VM_VERSION="1.148.0"
VM_SHA256="bde7ea38c7c9b341a0bb1f37294d6d619ff0318d70174008b57d83cd4f5698f3"
