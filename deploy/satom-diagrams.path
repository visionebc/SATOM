# Fires satom-diagrams.service whenever a Diagram Studio import is queued.
# Enabled on BOTH nodes: a standby whose watcher is off accepts imports and
# never recognises them. The self-update runner arms it on first install.
[Unit]
Description=SATOM Diagram Studio import queue watcher

[Path]
DirectoryNotEmpty=/opt/satom/data/diagrams/queue
Unit=satom-diagrams.service

[Install]
WantedBy=multi-user.target
