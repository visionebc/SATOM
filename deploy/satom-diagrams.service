# Diagram Studio recogniser. Triggered by satom-diagrams.path when
# data/diagrams/queue/ becomes non-empty.
#
# Same shape as satom-scripts.service: NO EnvironmentFile. This process never
# needs the database or FERNET_KEY -- it reads uploaded files by their hash
# from data/diagrams/sources/ and writes status and result files -- so it is
# not given them. Every file is parsed inside the bubblewrap jail of
# app/services/sandbox.py (no network, no SATOM files) on top of this
# containment: draw.io, Visio, SVG, PDF and image parsers are where hostile
# input does its damage.
[Unit]
Description=SATOM Diagram Studio recogniser (unprivileged, oneshot, no database)
After=network.target

# One start per queued import: systemd's default start limit (5 in 10 s)
# would stop this unit -- and with it the .path watcher, for good, until
# someone ran reset-failed -- after a few quick imports (measured on a1 with
# the scripts runner). The runner itself bounds its work (MAX_DRAIN per start,
# and it moves anything it cannot process out of the queue, so
# DirectoryNotEmpty cannot spin).
StartLimitIntervalSec=0
[Service]
Type=oneshot
User=satom
Group=satom
WorkingDirectory=/opt/satom
Environment=FM_APP_DIR=/opt/satom
ExecStart=/opt/satom/venv/bin/python -m app.services.diagram_runner
# MAX_PARALLEL recognitions at a time, each at most 180 s in the jail plus an
# optional 60 s vision refinement, MAX_DRAIN per invocation; what is left
# re-fires through the .path unit.
TimeoutStartSec=3600

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# ONE writable root for queue/claimed/status/results/sources (the claim is a
# rename between them; two bind-mounts would make it EXDEV).
ReadWritePaths=-/opt/satom/data/diagrams
InaccessiblePaths=-/opt/satom/.env -/opt/satom/pki -/opt/satom/.ssh
# NO ProtectKernelTunables= and NO ProtectProc= here (2026-11-13, FA-0016):
# both put read-only mounts over parts of /proc, and on a SLES 15 VM bwrap then
# could not mount the jail's own /proc ("Can't mount proc on /newroot/proc:
# Operation not permitted"): the kernel only allows a new proc mount where an
# uncovered one is visible. An LXC with nesting hides that (/dev/.lxc/proc).
# The jail's private pid namespace and /proc are what keep a parser away from
# other processes; /proc/sys is not writable by the satom uid anyway.

# Resource caps. The recogniser runs in this unit's cgroup, and the LXC it
# shares with Postgres and gunicorn has a few GB of RAM: without a cap one
# decompression bomb or a huge scanned page takes the node down. RLIMIT_NPROC
# cannot do this job -- it counts every process of the satom uid on the node.
# The jail's work directory and its /tmp live in this unit's /tmp, a tmpfs
# whose pages are charged to MemoryMax: no import can fill the disk. MemoryMax
# alone, no MemoryHigh: a throttle below the cap kept a runaway run alive and
# stalled until its timeout (measured on a1 with the scripts runner); at the
# cap the kernel ends it at once and the import record says why. A site that
# recognises very large scans raises these in a drop-in.
MemoryMax=1G
TasksMax=256
# The kernel ends the process that hit MemoryMax -- the parser, whose jail
# runs at oom_score_adj 1000 -- and the runner carries on and records it.
# The default (stop) would stop the whole unit, runner and every other import
# with it, and leave the import marked "running".
OOMPolicy=continue
CPUQuota=200%
CPUWeight=20
IOWeight=20
TemporaryFileSystem=/tmp:size=512M,mode=1777
