# Script Library runner. Triggered by satom-scripts.path when
# data/scripts/queue/ becomes non-empty.
#
# Same shape as satom-integrations.service with one more inversion: NO
# EnvironmentFile. This process never needs the database or FERNET_KEY -- it
# reads frozen script trees and writes status files -- so it is not given
# them. Each script runs inside the bubblewrap jail of app/services/sandbox.py
# on top of this containment.
[Unit]
Description=SATOM Script Library runner (unprivileged, oneshot, no database)
After=network.target

[Service]
Type=oneshot
User=satom
Group=satom
WorkingDirectory=/opt/satom
Environment=FM_APP_DIR=/opt/satom
ExecStart=/opt/satom/venv/bin/python -m app.services.script_runner
# MAX_PARALLEL runs at a time, each at most 900 s, MAX_DRAIN per invocation;
# what is left re-fires through the .path unit.
TimeoutStartSec=4500

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# ONE writable root for queue/claimed/status (the claim is a rename between
# them; two bind-mounts would make it EXDEV). The script sources are
# read-only to this unit: a run cannot rewrite the library it runs from.
ReadWritePaths=-/opt/satom/data/scripts
ReadOnlyPaths=-/opt/satom/data/scripts/library
InaccessiblePaths=-/opt/satom/.env -/opt/satom/pki -/opt/satom/.ssh
ProtectProc=invisible

# Resource caps (2026-10-20). Operator code runs in this unit's cgroup, and
# the LXC it shares with Postgres and gunicorn has a few GB of RAM: without a
# cap, one script that allocates, forks or writes in a loop takes the node
# down (measured: no MemoryMax, TasksMax 106611, /tmp on the root disk).
# RLIMIT_NPROC cannot do this job -- it counts every process of the satom uid
# on the node. The jail's work directory and its /tmp live in this unit's
# /tmp, a tmpfs whose pages are charged to MemoryMax: no run can fill the
# disk. MemoryMax alone, no MemoryHigh: a throttle below the cap kept a
# runaway run alive and stalled until its timeout (measured on a1); at the cap
# the kernel ends it at once and the run record says why. A site that needs
# more raises these in a drop-in.
MemoryMax=1G
TasksMax=256
CPUQuota=200%
CPUWeight=20
IOWeight=20
TemporaryFileSystem=/tmp:size=512M,mode=1777
