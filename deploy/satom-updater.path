# Watches the update-request queue. When the web app (unprivileged) drops a
# request JSON into data/update-requests/, this fires the privileged runner.
# DirectoryNotEmpty re-fires if the runner leaves anything queued, so requests
# are drained one after another.
[Unit]
Description=Watch for SATOM self-update requests

[Path]
DirectoryNotEmpty=/opt/satom/data/update-requests
Unit=satom-updater.service

[Install]
WantedBy=multi-user.target
