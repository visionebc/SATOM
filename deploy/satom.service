[Unit]
Description=SATOM Web App
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/satom
EnvironmentFile=/opt/satom/.env
# --timeout must stay ABOVE the provider timeout in
# app/services/advisor_providers.py (DEFAULT_TIMEOUT). Below it, a slow model
# has its worker killed first and the operator gets a dropped connection
# instead of the provider's own "request timed out" -- the diagnosable error
# is replaced by the opaque one. The advisor also streams, so a normal reply
# legitimately holds a sync worker for as long as the model is generating.
ExecStart=/opt/satom/venv/bin/gunicorn --workers 4 --bind 0.0.0.0:8000 --timeout 600 --access-logfile /var/log/satom/access.log --error-logfile /var/log/satom/error.log wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
